<!--
    Audio Switcher fullscreen theme integration example.
    Copy the parts you need into a fullscreen theme view or overlay.

    This file intentionally shows several integration styles together:
    - Direct PluginSettings bindings for fully custom UI.
    - Bundled ContentControl elements for reliable gamepad-friendly controls.
    - Compact widgets for quick topbar/overlay integration.

    Theme authors usually do not need every block at once.
-->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            FocusManager.IsFocusScope="True"
            KeyboardNavigation.DirectionalNavigation="Contained"
            KeyboardNavigation.TabNavigation="Cycle">

    <!--
        Minimal custom output button.
        ToggleSelectorCommand opens/closes the selector state exposed by the plugin.
        CurrentDeviceIconGeometry and CurrentDeviceName reflect the active output device.
    -->
    <Button Command="{PluginSettings Plugin=AudioSwitcher, Path=ToggleSelectorCommand}">
        <StackPanel Orientation="Horizontal">
            <Path Width="22"
                  Height="22"
                  Stretch="Uniform"
                  Fill="{DynamicResource TextBrush}"
                  Data="{PluginSettings Plugin=AudioSwitcher, Path=CurrentDeviceIconGeometry}" />
            <TextBlock Margin="8,0,0,0"
                       Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentDeviceName}" />
        </StackPanel>
    </Button>

    <!--
        Controller-friendly output device selector panel.
        Keep this panel as a focus scope so D-pad/left-stick navigation stays inside it.
        AudioSwitcher_DeviceList renders focusable buttons for all visible output devices.
        The panel is shown only while IsSelectorOpen is true.
    -->
    <Border FocusManager.IsFocusScope="True"
            KeyboardNavigation.DirectionalNavigation="Contained"
            KeyboardNavigation.TabNavigation="Cycle">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{PluginSettings Plugin=AudioSwitcher, Path=IsSelectorOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ContentControl x:Name="AudioSwitcher_DeviceList" />
    </Border>

    <!--
        Output volume integration.
        CurrentVolumeLabel is a simple text binding.
        AudioSwitcher_VolumeSlider is the bundled slider that handles focus and left/right input.
        AudioSwitcher_OutputWidget is a compact drop-in control with device, volume and mute state.
    -->
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentVolumeLabel}" />
    <ContentControl x:Name="AudioSwitcher_VolumeSlider" />
    <ContentControl x:Name="AudioSwitcher_OutputWidget" />

    <!--
        Input/microphone integration.
        These bindings follow the same pattern as output, but target the current default recording device.
        AudioSwitcher_InputWidget is useful when a theme wants a small microphone status block.
    -->
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentInputDeviceName}" />
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentInputVolumeLabel}" />
    <ContentControl x:Name="AudioSwitcher_InputVolumeSlider" />
    <ContentControl x:Name="AudioSwitcher_InputWidget" />

    <!--
        Current game audio session integration.
        CurrentGameName is the Playnite game name.
        CurrentGameSessionName is the matched Windows audio session/process.
        GameSessionStatusLabel is localized and safe to show while no game/session is available.
        AudioSwitcher_GameVolumeSlider controls the currently running game's Windows mixer session.
        AudioSwitcher_GameVolumeWidget is the compact drop-in version for overlays.
    -->
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentGameName}" />
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentGameSessionName}" />
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=GameSessionStatusLabel}" />
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentGameVolumeLabel}" />
    <ContentControl x:Name="AudioSwitcher_GameVolumeSlider" />
    <ContentControl x:Name="AudioSwitcher_GameVolumeWidget" />

    <!--
        Background/media audio session integration.
        MediaSessions exposes active Windows playback sessions that are not the current game session.
        This can catch Spotify, browsers/YouTube, UniPlaySong, or any app with a normal Core Audio session.
        Browsers are exposed by process/session, not by individual tab.
        AudioSwitcher_MediaMixer shows each session with its own slider, which is best for quick overlays.
        If the theme needs a custom layout, use AudioSwitcher_MediaSessionList or SetMediaSessionCommand to choose one.
        AudioSwitcher_MediaVolumeSlider controls the selected media session volume.
        AudioSwitcher_MediaWidget is the compact drop-in version for overlays.
    -->
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentMediaSessionName}" />
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentMediaSessionProcessName}" />
    <TextBlock Text="{PluginSettings Plugin=AudioSwitcher, Path=CurrentMediaSessionVolumeLabel}" />
    <ContentControl x:Name="AudioSwitcher_MediaMixer" />
    <ContentControl x:Name="AudioSwitcher_MediaSessionList" />
    <ContentControl x:Name="AudioSwitcher_MediaVolumeSlider" />
    <ContentControl x:Name="AudioSwitcher_MediaWidget" />

    <!--
        Optional in-theme toast/status area.
        LastChangeMessage updates when Audio Switcher changes output, input, volume or mute state.
        LastChangeIconGeometry can be rendered in a Path if the theme wants an icon beside the message.
    -->
    <StackPanel Orientation="Horizontal">
        <Path Width="18"
              Height="18"
              Stretch="Uniform"
              Fill="{DynamicResource TextBrush}"
              Data="{PluginSettings Plugin=AudioSwitcher, Path=LastChangeIconGeometry}" />
        <TextBlock Margin="8,0,0,0"
                   Text="{PluginSettings Plugin=AudioSwitcher, Path=LastChangeMessage}" />
    </StackPanel>
</StackPanel>
