<UserControl x:Class="PlayniteAudioSwitcher.AudioSwitcherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="980"
             MinHeight="640"
             d:DesignHeight="780"
             d:DesignWidth="1100"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FontSize="14"
             TextElement.FontSize="14"
             TextElement.Foreground="{DynamicResource TextBrush}"
             Background="{DynamicResource Narian.Bg}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsToggleTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PageHeader" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}" />
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="IndentedHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="WarningHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FFE24B4B" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style x:Key="IconSquareButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NarianPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderValueText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SliderRangeText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="FillScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="PageSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.BadgeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="DeviceStatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CapabilityPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style x:Key="SummaryMetricPill" TargetType="Border" BasedOn="{StaticResource CapabilityPill}" />
        <Style x:Key="DeviceCard" TargetType="Border" BasedOn="{StaticResource SummaryCard}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="CompactSliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="TabGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="ExpanderHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HeaderChrome" DockPanel.Dock="Top" MinHeight="52" ClipToBounds="False"
                                    Cursor="Hand">
                                <Grid ClipToBounds="False">
                                    <Rectangle x:Name="ExpanderFill" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource ControlBackgroundBrush}" />
                                    <Rectangle x:Name="ExpanderAccent" Width="4" HorizontalAlignment="Left"
                                               RadiusX="4" RadiusY="4" Fill="Transparent" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Margin="16,8,8,8" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ContentPresenter x:Name="ExpanderHeader" ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  HorizontalAlignment="Stretch"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock x:Name="ExpanderHint" Grid.Row="1"
                                                           Text="{DynamicResource LOCAS_ExpandSectionHint}"
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,4,0,0" />
                                            </Grid>
                                        </ToggleButton>
                                        <Button x:Name="ExpanderChevron" Grid.Column="1"
                                                Style="{StaticResource IconSquareButton}"
                                                VerticalAlignment="Center"
                                                Click="ExpanderChevronButton_OnClick">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox.RenderTransform>
                                                    <TranslateTransform X="-1" Y="-1" />
                                                </Viewbox.RenderTransform>
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="ExpanderArrow"
                                                          Data="M6,9 L12,15 L18,9"
                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ExpanderContent" Visibility="Collapsed" Padding="16,16,8,16"
                                    TextElement.Foreground="{DynamicResource TextBrush}"
                                    TextElement.FontSize="14">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter TargetName="ExpanderAccent" Property="Fill" Value="{DynamicResource HighlightGlyphBrush}" />
                                <Setter TargetName="ExpanderHint" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ExpanderArrow" Property="Data" Value="M6,15 L12,9 L18,15" />
                                <Setter TargetName="ExpanderHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Rectangle x:Name="NavigationFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <Rectangle x:Name="NavigationAccent" Width="4" HorizontalAlignment="Left"
                                       RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="16,8,16,8"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource Narian.Selected}" />
                                <Setter TargetName="NavigationAccent" Property="Fill" Value="{DynamicResource Narian.Accent}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                    Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    ClipToBounds="False">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource Narian.Accent}" FontSize="14" FontWeight="SemiBold"
                                               Margin="8,8,8,16" TextWrapping="Wrap" />
                                    <StackPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Rectangle x:Name="TabFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,8"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource Narian.Selected}" />
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabs" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TopTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                    Padding="6" ClipToBounds="False"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <WrapPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16,16">
        <TabControl x:Name="RootTabs" Style="{StaticResource TopTabs}" SelectionChanged="RootTabsSelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE80F;" />
                        <TextBlock Text="{DynamicResource LOCAS_OverviewTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{DynamicResource LOCAS_OverviewRefresh}"
                                            Style="{StaticResource NarianPrimaryButton}"
                                            MinWidth="130"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Click="RefreshOverview" />
                                    <TextBlock Text="{DynamicResource LOCAS_OverviewTab}"
                                               Style="{StaticResource SectionHeaderText}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource LOCAS_OverviewHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCAS_AppearancePreset}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{DynamicResource LOCAS_AppearancePresetHelp}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                <WrapPanel x:Name="AppearancePresetChips" Orientation="Horizontal" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCAS_OverviewOutput}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="OverviewOutputText" Style="{StaticResource SummaryCardValue}" />
                                        <WrapPanel x:Name="OverviewOutputPills" Margin="0,8,0,0">
                                            <Border x:Name="OverviewOutputVolumePill" Style="{StaticResource SummaryMetricPill}">
                                                <TextBlock x:Name="OverviewOutputVolumeText" />
                                            </Border>
                                            <Border x:Name="OverviewOutputBatteryPill" Style="{StaticResource SummaryMetricPill}">
                                                <TextBlock x:Name="OverviewOutputBatteryText" />
                                            </Border>
                                        </WrapPanel>
