<UserControl x:Class="PlayniteAudioSwitcher.AudioSwitcherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="900">
    <Grid Margin="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8" MaxWidth="820">
                <TextBlock Text="{DynamicResource LOCAS_CustomNamesTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{DynamicResource LOCAS_CustomNamesHelp}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <StackPanel x:Name="DeviceRowsPanel" Margin="0,0,0,12" />

                <TextBlock Text="{DynamicResource LOCAS_FullscreenDisplayMode}" />
                <ComboBox ItemsSource="{Binding DeviceDisplayModeOptions}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding DeviceDisplayMode}"
                          Margin="0,2,0,10" />

                <TextBlock Text="{DynamicResource LOCAS_FullscreenPreferredDevice}" Margin="0,4,0,0" />
                <ComboBox ItemsSource="{Binding AvailablePlaybackDevices}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding FullscreenPreferredDeviceId}"
                          Margin="0,2,0,10" />

                <CheckBox Content="{DynamicResource LOCAS_EnableQuickSwitch}"
                          IsChecked="{Binding QuickSwitchEnabled}"
                          Margin="0,2,0,8" />

                <CheckBox Content="{DynamicResource LOCAS_ShowOnlyCustom}"
                          IsChecked="{Binding FullscreenOnlyFavorites}"
                          Margin="0,0,0,8" />

                <CheckBox Content="{DynamicResource LOCAS_ApplyPreferredOnStartup}"
                          IsChecked="{Binding ApplyFullscreenPreferredOnStartup}"
                          Margin="0,0,0,8" />

                <CheckBox Content="{DynamicResource LOCAS_RestoreAfterGame}"
                          IsChecked="{Binding RestoreDeviceAfterGameProfile}"
                          Margin="0,0,0,8" />

                <CheckBox Content="{DynamicResource LOCAS_ShowNotification}"
                          IsChecked="{Binding ShowNotifications}"
                          Margin="0,0,0,12" />

                <Border BorderBrush="#444444" BorderThickness="1" Padding="10">
                    <TextBlock Text="{DynamicResource LOCAS_QuickSwitchHelp}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
