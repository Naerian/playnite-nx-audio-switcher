<UserControl x:Class="PlayniteAudioSwitcher.AudioSwitcherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>
        <Style x:Key="FirstSectionHeaderBorder" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="{DynamicResource LOCAS_OutputTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_OutputDevicesTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_OutputDevicesHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <StackPanel x:Name="DeviceRowsPanel" Margin="0,0,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_InputTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_InputDevicesTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_InputDevicesHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <StackPanel x:Name="InputDeviceRowsPanel" Margin="0,0,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_FullscreenTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_MenuSwitchCustom}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_QuickSwitchHelpAll}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <CheckBox Content="{DynamicResource LOCAS_EnableQuickSwitch}"
                                  IsChecked="{Binding QuickSwitchEnabled}"
                                  Margin="0,2,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_QuickSwitchAllDevices}"
                                  IsChecked="{Binding QuickSwitchAllDevices}"
                                  Margin="0,0,0,8" />

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_VolumeTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_VolumeHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource LOCAS_VolumeStep}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Slider Grid.Column="1"
                                    Minimum="1"
                                    Maximum="50"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding VolumeStepPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding VolumeStepPercent, StringFormat={}{0}%}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_MediaSettingsTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_MediaGroupingHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_ShowMediaSessionIcons}"
                                  IsChecked="{Binding ShowMediaSessionIcons}"
                                  Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource LOCAS_ShowMediaSessionIconsHelp}"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_GameProfilesTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_GameProfilesTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_GameProfilesHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_EnableGameProfiles}"
                                  IsChecked="{Binding GameProfilesEnabled}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_RestoreAfterGame}"
                                  IsChecked="{Binding RestoreDeviceAfterGameProfile}"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_SpatialSoundTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_SpatialSoundTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_SpatialSoundHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource LOCAS_SpatialSoundNotBundled}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource LOCAS_SpatialSoundToolInfo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Margin="0,0,16,0">
                                <Hyperlink NavigateUri="https://www.nirsoft.net/utils/sound_volume_view.html"
                                           RequestNavigate="OpenExternalLink">
                                    SoundVolumeView
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock>
                                <Hyperlink NavigateUri="https://www.nirsoft.net/utils/sound_volume_command_line.html"
                                           RequestNavigate="OpenExternalLink">
                                    svcl
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <CheckBox Content="{DynamicResource LOCAS_EnableSpatialSoundIntegration}"
                                  IsChecked="{Binding SpatialSoundIntegrationEnabled}"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource LOCAS_SpatialSoundToolPath}"
                                   Margin="0,0,0,3" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SpatialSoundToolPathBox"
                                     Text="{Binding SpatialSoundToolPath, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="SpatialSoundToolPathChanged"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="{DynamicResource LOCAS_Browse}"
                                    MinWidth="90"
                                    Margin="0,0,8,0"
                                    Click="BrowseSpatialSoundToolPath" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource LOCAS_Test}"
                                    MinWidth="80"
                                    Click="TestSpatialSoundToolPath" />
                        </Grid>

                        <TextBlock x:Name="SpatialSoundToolStatus"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Margin="0,-4,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_MaintenanceTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_MaintenanceDiagnosticsTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_MaintenanceDiagnosticsHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <Button Content="{DynamicResource LOCAS_AudioSessionDiagnostics}"
                                MinWidth="220"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,18"
                                Click="ExportAudioSessionDiagnostics" />

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_MaintenanceBackupTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_MaintenanceBackupHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource LOCAS_ExportSettingsBackup}"
                                    MinWidth="180"
                                    Margin="0,0,8,0"
                                    Click="ExportSettingsBackup" />
                            <Button Content="{DynamicResource LOCAS_ImportSettingsBackup}"
                                    MinWidth="180"
                                    Click="ImportSettingsBackup" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_NotificationsTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_NotificationsTitle}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_NotificationsHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="{DynamicResource LOCAS_ShowNotification}"
                                  IsChecked="{Binding ShowNotifications}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource LOCAS_NotificationCategories}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifyOutputDevice}"
                                  IsChecked="{Binding ShowOutputDeviceNotifications}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifyInputDevice}"
                                  IsChecked="{Binding ShowInputDeviceNotifications}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifyVolume}"
                                  IsChecked="{Binding ShowVolumeNotifications}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifyMute}"
                                  IsChecked="{Binding ShowMuteNotifications}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifyGameProfile}"
                                  IsChecked="{Binding ShowGameProfileNotifications}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifySpatialSound}"
                                  IsChecked="{Binding ShowSpatialSoundNotifications}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="{DynamicResource LOCAS_NotifyDiagnostics}"
                                  IsChecked="{Binding ShowDiagnosticNotifications}"
                                  Margin="0,0,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCAS_AboutTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource FirstSectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_AboutTitle}"
                                       Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_AboutDescription}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="AboutVersionText"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,18" />

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_ProjectLinksTitle}"
                                       Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <WrapPanel Margin="0,0,0,2">
                            <Button Content="{DynamicResource LOCAS_OpenGitHub}"
                                    Tag="https://github.com/Naerian/playnite-nx-audio-switcher"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Click="OpenExternalButton" />
                            <Button Content="{DynamicResource LOCAS_OpenWiki}"
                                    Tag="https://github.com/Naerian/playnite-nx-audio-switcher/wiki"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Click="OpenExternalButton" />
                            <Button Content="{DynamicResource LOCAS_ReportIssue}"
                                    Tag="https://github.com/Naerian/playnite-nx-audio-switcher/issues/new"
                                    MinWidth="150"
                                    Margin="0,0,0,8"
                                    Click="OpenExternalButton" />
                        </WrapPanel>

                        <Border Style="{StaticResource SectionHeaderBorder}">
                            <TextBlock Text="{DynamicResource LOCAS_SupportTitle}"
                                       Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCAS_KoFiSupportHelp}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Button Content="{DynamicResource LOCAS_KoFiSupport}"
                                Tag="https://ko-fi.com/naerian"
                                HorizontalAlignment="Left"
                                MinWidth="150"
                                Padding="16,7"
                                Click="OpenExternalButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
