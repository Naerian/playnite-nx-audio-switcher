                            <TextBlock Text="{DynamicResource LOCAS_MaintenanceBackupHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCAS_MaintenanceDiagnosticsTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCAS_MaintenanceDiagnosticsHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldGroup}">
                        <Button Content="{DynamicResource LOCAS_AudioSessionDiagnostics}"
                                HorizontalAlignment="Left"
                                MinWidth="220"
                                Margin="0,0,0,0"
                                Click="ExportAudioSessionDiagnostics" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCAS_MaintenanceBackupTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCAS_MaintenanceBackupHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="{DynamicResource LOCAS_ExportSettingsBackup}"
                                    MinWidth="180"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,8,8"
                                    Click="ExportSettingsBackup" />
                            <Button Content="{DynamicResource LOCAS_ImportSettingsBackup}"
                                    MinWidth="180"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"
                                    Click="ImportSettingsBackup" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE946;" />
                        <TextBlock Text="{DynamicResource LOCAS_AboutTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCAS_AboutTab}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCAS_AboutDescription}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <TextBlock x:Name="AboutVersionText"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeaderBorder}">
                                    <TextBlock Text="{DynamicResource LOCAS_AboutPurposeTitle}" Style="{StaticResource SectionHeaderText}" />
                                </Border>
                                <TextBlock Text="{DynamicResource LOCAS_AboutDevices}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCAS_AboutProfiles}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCAS_AboutIntegration}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCAS_ProjectLinksTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="{DynamicResource LOCAS_OpenGitHub}"
                                            Tag="https://github.com/Naerian/playnite-nx-audio-switcher"
                                            MinWidth="100"
                                            Margin="0,0,8,8"
                                            Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCAS_OpenWiki}"
                                            Tag="https://github.com/Naerian/playnite-nx-audio-switcher/wiki"
                                            MinWidth="100"
                                            Margin="0,0,8,8"
                                            Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCAS_ReportIssue}"
                                            Tag="https://github.com/Naerian/playnite-nx-audio-switcher/issues/new"
                                            MinWidth="140"
                                            Margin="0,0,0,8"
                                            Click="OpenExternalButton" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCAS_SupportTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <Button Content="{DynamicResource LOCAS_KoFiSupport}"
                                        Tag="https://ko-fi.com/naerian"
                                        HorizontalAlignment="Left"
                                        MinWidth="150"
                                        Padding="16,8"
                                        Click="OpenExternalButton" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
