<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioDeviceSelectorPanelControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="460"
          Margin="24">
        <Border Padding="22"
                Background="{DynamicResource NormalBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource LOCAS_AudioOutput}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock Text="{DynamicResource LOCAS_SelectorPanelHelp}"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Margin="0,0,0,14" />
                <TextBlock Text="{DynamicResource LOCAS_MenuChooseOutput}"
                           Margin="0,0,0,4" />
                <ContentControl x:Name="SelectorHost" />
            </StackPanel>
        </Border>
    </Grid>
</playnite:PluginUserControl>
