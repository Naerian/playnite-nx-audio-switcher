<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioBatteryTopPanelControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.ToolTip>
            <TextBlock Text="{Binding CurrentDeviceName}" />
        </StackPanel.ToolTip>
        <Viewbox Width="20" Height="20" Margin="2,0,5,0">
            <Path Data="{Binding BatteryIndicatorIconGeometry}"
                  Stretch="Uniform"
                  Stroke="{DynamicResource TextBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent" />
        </Viewbox>
        <TextBlock Text="{Binding CurrentDeviceBatteryLabel}"
                   Foreground="{DynamicResource TextBrush}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Margin="0,0,2,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasCurrentDeviceBattery}" Value="True" />
                                <Condition Binding="{Binding ShowBatteryIndicatorPercentage}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</playnite:PluginUserControl>
