<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioBatteryWidgetControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShouldShowBatteryIndicator}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <StackPanel.ToolTip>
            <StackPanel><TextBlock Text="{Binding CurrentDeviceName}" FontWeight="SemiBold" /><TextBlock Text="{Binding BatteryIndicatorLabel}" /></StackPanel>
        </StackPanel.ToolTip>
        <Viewbox Width="20" Height="20" Margin="2,0,5,0">
            <Viewbox.Style>
                <Style TargetType="Viewbox"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowBatteryIndicatorIcon}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
            </Viewbox.Style>
            <Path Data="{Binding BatteryIndicatorIconGeometry}" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
        </Viewbox>
        <TextBlock Text="{Binding BatteryIndicatorLabel}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,2,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowBatteryIndicatorPercentage}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</playnite:PluginUserControl>
