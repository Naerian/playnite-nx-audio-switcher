<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioCurrentDeviceControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding CurrentDeviceLabel}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Margin="8,0,0,0"
                   Text="{Binding CurrentDeviceBatteryLabel}"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</playnite:PluginUserControl>
