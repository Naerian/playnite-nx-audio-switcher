    <sys:String x:Key="LOCAS_MaintenanceDiagnosticsTitle">Support diagnostics</sys:String>
    <sys:String x:Key="LOCAS_MaintenanceDiagnosticsHelp">Exporta um relatório com as sessões de reprodução do Windows que o Audio Switcher consegue ver. Use quando um perfil de volume de jogo ou slider de tema não detectar o processo esperado.</sys:String>
