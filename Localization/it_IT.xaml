    <sys:String x:Key="LOCAS_DesktopIntegrationTitle">Integrazione con la barra superiore Desktop</sys:String>
    <sys:String x:Key="LOCAS_DesktopIntegrationHelp">Mantieni Audio Switcher accessibile dalla barra superiore Desktop di Playnite. Il passaggio del mouse mostra l’uscita attiva e un clic apre le impostazioni.</sys:String>
