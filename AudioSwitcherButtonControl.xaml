<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioSwitcherButtonControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Button x:Name="SwitchButton"
            Click="SwitchButton_Click"
            MinWidth="120"
            Padding="12,6">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentDeviceLabel}" />
            <TextBlock Margin="8,0,0,0" Text="{Binding CurrentDeviceBatteryLabel}" />
        </StackPanel>
    </Button>
</playnite:PluginUserControl>
