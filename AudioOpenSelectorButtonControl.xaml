<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioOpenSelectorButtonControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Grid>
        <Button x:Name="OpenButton"
                Click="OpenButton_Click"
                MinWidth="120"
                Padding="12,6" />
        <Popup x:Name="SelectorPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border x:Name="SelectorPopupContent"
                    Background="{DynamicResource NormalBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="1"
                    TextElement.Foreground="{DynamicResource TextBrush}"
                    Padding="12"
                    MinWidth="320"
                    MaxHeight="520" />
        </Popup>
    </Grid>
</playnite:PluginUserControl>
