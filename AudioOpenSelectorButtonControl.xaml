<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioOpenSelectorButtonControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Grid Width="34"
          Height="34">
        <Button x:Name="AudioSwitcherThemeOpenSelectorButton"
                Click="OpenButton_Click"
                PreviewKeyDown="OpenButton_PreviewKeyDown"
                Width="34"
                Height="34"
                MinWidth="34"
                Padding="7"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#18FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Width="20"
                     Height="20"
                     Stretch="Uniform">
                <Path x:Name="DeviceIconPath"
                      Stroke="{DynamicResource TextBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      Stretch="Uniform" />
            </Viewbox>
        </Button>

        <Popup x:Name="SelectorPopup"
               PlacementTarget="{Binding ElementName=AudioSwitcherThemeOpenSelectorButton}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Opened="SelectorPopup_Opened"
               Closed="SelectorPopup_Closed">
            <Border x:Name="SelectorPanel"
                    MinWidth="430"
                    MaxWidth="560"
                    MaxHeight="650"
                    Padding="22"
                    BorderThickness="1"
                    CornerRadius="12"
                    TextElement.Foreground="{DynamicResource TextBrush}">
                <ContentControl x:Name="SelectorHost" />
            </Border>
        </Popup>
    </Grid>
</playnite:PluginUserControl>
