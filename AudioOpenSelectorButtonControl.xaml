<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioOpenSelectorButtonControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Button x:Name="OpenButton"
            Click="OpenButton_Click"
            Width="34"
            Height="34"
            MinWidth="34"
            Padding="7"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
        <Viewbox Width="20"
                 Height="20"
                 Stretch="Uniform">
            <Path x:Name="DeviceIconPath"
                  Stroke="{DynamicResource TextBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  Stretch="Uniform" />
        </Viewbox>
    </Button>
</playnite:PluginUserControl>
