<playnite:PluginUserControl x:Class="PlayniteAudioSwitcher.AudioMediaWidgetControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="True">
    <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Viewbox x:Name="MediaIconHost"
                 Width="24"
                 Height="24"
                 VerticalAlignment="Center">
            <Path Data="{Binding CurrentMediaSessionVolumeIconGeometry}"
                  Stretch="Uniform"
                  Stroke="{DynamicResource TextBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent" />
        </Viewbox>

        <StackPanel Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentMediaSessionName}"
                       Foreground="{DynamicResource TextBrush}"
                       TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentMediaSessionVolumeLabel}"
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.75"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button Grid.Column="2"
                Command="{Binding ToggleMediaSessionMuteCommand}"
                Padding="4"
                MinWidth="32"
                MinHeight="32"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentMediaSessionVolumeLabel}"
                       Foreground="{DynamicResource TextBrush}"
                       TextAlignment="Center" />
        </Button>
    </Grid>
</playnite:PluginUserControl>
